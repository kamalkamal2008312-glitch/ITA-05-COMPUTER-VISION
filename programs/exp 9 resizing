
import cv2

# Read the image
image = cv2.imread("C:/Users/Kamal/Downloads/sunflower.jpg")

if image is None:
    print("Image not found!")
else:
    # Resize to a bigger size (2x scaling)
    bigger_image = cv2.resize(
        image, None, fx=2, fy=2,
        interpolation=cv2.INTER_LINEAR
    )

    # Resize to a smaller size (0.5x scaling)
    smaller_image = cv2.resize(
        image, None, fx=0.5, fy=0.5,
        interpolation=cv2.INTER_AREA
    )

    # Display images
    cv2.imshow("Original Image", image)
    cv2.imshow("Bigger Image", bigger_image)
    cv2.imshow("Smaller Image", smaller_image)

    # Wait and close windows
    cv2.waitKey(0)
    cv2.destroyAllWindows()
