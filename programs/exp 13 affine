
import cv2
import numpy as np

# Read the image
image = cv2.imread("C:/Users/Kamal/Downloads/sunflower.jpg")

if image is None:
    print("Image not found!")
else:
    rows, cols, ch = image.shape

    # Define three points in the original image
    pts1 = np.float32([[50, 50], [200, 50], [50, 200]])

    # Define three corresponding points in the output image
    pts2 = np.float32([[10, 100], [200, 50], [100, 250]])

    # Calculate affine transformation matrix
    matrix = cv2.getAffineTransform(pts1, pts2)

    # Apply affine transformation
    transformed_image = cv2.warpAffine(image, matrix, (cols, rows))

    # Display images
    cv2.imshow("Original Image", image)
    cv2.imshow("Affine Transformed Image", transformed_image)

    # Save the output image
    cv2.imwrite("C:/Users/Kamal/Downloads/affine_transformed.jpg", transformed_image)

    cv2.waitKey(0)
    cv2.destroyAllWindows()
