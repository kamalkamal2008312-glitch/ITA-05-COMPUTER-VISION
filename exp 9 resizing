import cv2

image_path = r"C:\Users\bolla\Downloads\tree_image.jpg"
image = cv2.imread(image_path)

if image is None:
    raise FileNotFoundError(f"Could not load image: {image_path}")

# Resize to 2× the original size
bigger_image = cv2.resize(
    image, None, fx=2, fy=2, interpolation=cv2.INTER_LINEAR
)

# Resize to half the original size
smaller_image = cv2.resize(
    image, None, fx=0.5, fy=0.5, interpolation=cv2.INTER_AREA
)

cv2.imshow("Original Image", image)
cv2.imshow("Bigger Image", bigger_image)
cv2.imshow("Smaller Image", smaller_image)
cv2.waitKey(0)
cv2.destroyAllWindows()
